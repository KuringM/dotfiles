{
  "servers": [
    { "tag": "local", "type": "udp", "server": "223.5.5.5" },
    {
      "tag": "public",
      "type": "https",
      "server": "dns.alidns.com",
      "domain_resolver": "local"
    },
    {
      "tag": "foreign",
      "type": "https",
      "server": "8.8.8.8",
      "detour": "🚀 默认代理"
    },
    {
      "tag": "fakeip",
      "type": "fakeip",
      "inet4_range": "198.18.0.0/15",
      "inet6_range": "fc00::/18"
